{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-06",
  "vars": {
    "JWT_ACCESS_SECRET": "replace-me-with-a-long-random-secret",
    "REFRESH_TOKEN_PEPPER": "replace-me-with-a-different-long-random-secret",
    "JWT_ISSUER": "YOUR_ISSUER",
    "JWT_AUDIENCE": "YOUR_AUDIENCE",
    "APP_ORIGIN": "YOUR_BASE_URL",
    "EMAIL_FROM": "youremail@email.com",
    "RESEND_API_KEY": "yourapikey"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-database",
      "database_id": ""
    }
  ]
}